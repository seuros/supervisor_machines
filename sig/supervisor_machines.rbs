# OTP-style supervision over Ruby threads.
#
# `Decider` is defined by the native extension, which binds the
# `supervisor-machines` crate: it decides which children a failure takes down
# and when restarting has stopped being worth it. `Supervisor` owns everything
# the core refuses to touch, which is every thread. Every instant and span is
# Integer nanoseconds.
module SupervisorMachines
  VERSION: String

  # Restarts OTP tolerates by default before escalating.
  DEFAULT_RESTARTS: Integer

  # The window OTP measures those restarts over: five seconds, in nanoseconds.
  DEFAULT_WINDOW: Integer

  # Which siblings a failure takes down with it.
  type strategy = :one_for_one | :one_for_all | :rest_for_one

  # When a child is worth restarting.
  type policy = :permanent | :transient | :temporary

  # How a child's run ended.
  type exit_kind = :normal | :abnormal

  # The core's `Decision`, every variant honoured.
  type decision = :ignore | Restart | :escalate | :already_escalated

  # The core's `Refusal`.
  type refusal = :unknown_child

  # The core's `Recording`.
  type recording = :recorded | :outdated

  # Every strategy, in the order the core declares them. Another Symbol raises
  # `RangeError`, a non-Symbol `TypeError`.
  STRATEGIES: Array[strategy]

  # Every policy, in the order the core declares them. Another Symbol raises
  # `RangeError`, a non-Symbol `TypeError`.
  POLICIES: Array[policy]

  # Every exit, in the order the core declares them.
  EXITS: Array[exit_kind]

  # Private native checks behind the values and Supervisor, TypeError for a
  # wrong type, RangeError for what the core rejects. `__intensity` and
  # `__span` answer the fields as the core holds them; `__restart`,
  # `__policy` and `__strategy` answer their argument; `__supervised_intensity`
  # reads exactly an Intensity and rebuilds it, RangeError past
  # Decider::MAX_RESTARTS.
  private def self.__intensity: (Integer restarts, Integer window) -> [Integer, Integer]
  private def self.__span: (Integer first, Integer last) -> [Integer, Integer]
  private def self.__restart: (Span span) -> Span
  private def self.__policy: (policy policy) -> policy
  private def self.__strategy: (strategy strategy) -> strategy
  private def self.__supervised_intensity: (Intensity intensity) -> Intensity

  # The core's `Intensity`: `restarts` within `window` nanoseconds. A zero
  # window, a negative value or one past its width raises `RangeError`; a
  # non-Integer `TypeError`.
  class Intensity < ::Data
    attr_reader restarts: Integer
    attr_reader window: Integer

    def self.new: (Integer restarts, Integer window) -> instance
                | (restarts: Integer, window: Integer) -> instance

    # The core's `Intensity::default`: one restart in five seconds.
    def self.default: () -> Intensity

    def initialize: (restarts: Integer, window: Integer) -> void
  end

  # The core's `Span`: the inclusive child indices `first..last`. `first` past
  # `last` or a negative end raises `RangeError`; a non-Integer `TypeError`.
  class Span < ::Data
    attr_reader first: Integer
    attr_reader last: Integer

    def self.new: (Integer first, Integer last) -> instance
                | (first: Integer, last: Integer) -> instance

    # The one child at `index`.
    def self.single: (Integer index) -> Span

    def initialize: (first: Integer, last: Integer) -> void

    # Children in the span, at least one.
    def size: () -> Integer

    # Never true.
    def empty?: () -> false

    def contains?: (untyped index) -> bool
  end

  # The core's `Decision::Restart`: restart `span` in index order. A non-Span
  # raises `TypeError`.
  class Restart < ::Data
    attr_reader span: Span

    def self.new: (Span span) -> instance
                | (span: Span) -> instance

    def initialize: (span: Span) -> void
  end

  class Error < StandardError
  end

  # Raised once a supervisor has spent its restart intensity.
  class Escalated < Error
  end

  # The core's `Supervisor`. A child count and a restart history are part of
  # its Rust type, so the count given here is dispatched to one of
  # `SUPPORTED_CHILDREN` monomorphised shapes, each keeping `HISTORY`
  # restart instants. Malformed arguments raise `TypeError` or `RangeError`
  # before the core is asked; mutating a frozen decider raises `FrozenError`.
  class Decider
    # Restart instants every shape keeps.
    HISTORY: Integer

    # The most restarts an intensity may tolerate: `HISTORY - 1`.
    MAX_RESTARTS: Integer

    # The child counts a decider can be built for. Anything else raises
    # `RangeError`.
    SUPPORTED_CHILDREN: Array[Integer]

    # `RangeError` for an unsupported child count or more restarts than
    # `MAX_RESTARTS`.
    def self.new: (Integer children, strategy strategy, Intensity intensity) -> instance

    # A decider holding the restarts of `history` inside the window as of
    # `now`, the newest `HISTORY` of them, every instant counted (two restarts
    # at one instant restore as two). Not terminated.
    def self.restore: (
      Integer children,
      strategy strategy,
      Intensity intensity,
      Array[Integer] history,
      Integer now
    ) -> instance

    # What to do about the child at `index`. `Restart` and `:escalate` record
    # `now`; `:ignore`, `:already_escalated` and the refusal `:unknown_child`
    # record nothing. Decided on a copy kept once the answer is built:
    # `RuntimeError` when the decider changed meanwhile (outer call not
    # applied).
    def stopped: (Integer index, policy policy, exit_kind exit, Integer now) -> (decision | refusal)

    # Counts a restart another process performed at `now`: `:recorded`, or
    # `:outdated` (nothing changed) when a full history holds only newer ones.
    def record_external_restart: (Integer now) -> recording

    # Merges another process's history (any order), keeping the larger count
    # of each instant; answers how many restarts were added. A repeat adds 0.
    def absorb: (Array[Integer] history, Integer now) -> Integer

    # Every restart instant held, oldest first. Frozen.
    def history: () -> Array[Integer]

    # The children a failure at `index` takes with it, or nil past the count.
    def span: (Integer index) -> Span?

    def children: () -> Integer

    def strategy: () -> strategy

    def intensity: () -> Intensity

    # True once the core has escalated, and true from then on.
    def terminated?: () -> bool

    # Restarts still inside the intensity window as of `now`.
    def recent_restarts: (Integer now) -> Integer

    # How long to hold off a granted restart, in nanoseconds.
    def restart_delay: (Integer base, Integer ceiling, Integer now) -> Integer

    def inspect: () -> String
  end

  # A supervision tree over threads.
  class Supervisor
    # Where a tree is in its lifecycle: registering children, running them, or
    # ended — `stopped` by its caller, `failed` by giving up.
    type state = :registering | :running | :stopped | :failed

    # Nanoseconds a supervisor taking itself down waits for a killed child.
    ESCALATION_GRACE: Integer

    # Anything that can price the wait between a restart decision and the
    # respawn, in Integer nanoseconds from an attempt (1..255) and a draw
    # (0...2**64): a `chrono_machines` shape, BACKOFF unless told otherwise.
    interface _Backoff
      def delay: (Integer attempt, Integer draw) -> Integer
    end

    # A ChronoMachines::Exponential: 100 ms doubling to 10 s, full jitter.
    BACKOFF: _Backoff

    # A registered child and whichever thread currently runs it. Private;
    # replaced under the tree's lock, never mutated.
    class Child < ::Data
      attr_reader name: untyped
      attr_reader policy: policy
      attr_reader starter: ^() -> Thread
      attr_reader thread: Thread?
      attr_reader epoch: Integer
      attr_reader done: bool

      def self.new: (untyped name, policy policy, (^() -> Thread)? starter, Thread? thread, Integer epoch,
                     bool done) -> instance

      def initialize: (name: untyped, policy: policy, starter: (^() -> Thread)?, thread: Thread?, epoch: Integer,
                       done: bool) -> void

      def with: (?thread: Thread?, ?epoch: Integer, ?done: bool) -> Child
    end

    attr_reader strategy: strategy

    attr_reader intensity: Intensity

    # `TypeError` for a non-Symbol strategy or a non-Intensity, `RangeError`
    # for an unknown strategy or more restarts than `Decider::MAX_RESTARTS`.
    # `backoff:` and `supervise`'s `policy: :permanent` are the runtime's own
    # keyword defaults: this class runs threads on top of the core rather
    # than mirroring it (`Decider` is the mirror).
    def initialize: (strategy strategy, Intensity intensity, ?backoff: _Backoff?) -> void

    # Registers a child under `name`. The block returns the `Thread` that runs
    # it, and is called again for every restart.
    # `TypeError`/`RangeError` for a policy outside POLICIES.
    def supervise: (untyped name, ?policy: policy) { () -> Thread } -> self

    # Fixes the shape of the tree and starts every child in registration
    # order. Raises `RangeError` for a child count the core has no shape
    # for, `Error` for a tree that is past registering, and whatever a starter
    # raised after taking the children already up back down.
    def start: () -> self

    # Child names, in start order.
    def children: () -> Array[untyped]

    # Restarts still inside the intensity window.
    def restarts: () -> Integer

    def terminated?: () -> bool

    # Takes every running child down in reverse start order within `grace`
    # nanoseconds, or all the time it needs when `grace` is nil. A tree still
    # registering has nothing to take down. `TypeError` for a non-Integer
    # grace, `RangeError` for a negative one. Raises `Escalated` for a tree
    # that gave up, every time it is called.
    def stop: (?Integer? grace) -> self

    private

    # What a starter raised, after the children already up have been taken
    # back down, or nil once the whole tree is up.
    def launch: () -> Exception?
    def rollback: () -> void
    def running?: () -> bool
    def monitor: () -> void
    def handle: (Integer index, Integer epoch, exit_kind ending) -> void
    def restart: (Span span) -> void
    def respawn: (Span span) -> String?
    def escalate: (?String reason) -> void
    def shutdown: (?Integer? grace) -> Array[Exception]
    def reap: (Thread thread, Integer? remaining) -> Exception?
    def spawn: (Integer index) -> void

    # Installs a started thread under the generation that asked for it, killing
    # it when the tree has moved past that generation.
    def install: (Integer index, Integer generation, Thread thread) -> void
    def retire: (Integer index) -> Thread?
    def watch: (Integer index, Integer epoch, Thread thread) -> void
    def escalation: () -> String
    def abandoned: () -> String
    def unstarted: (Exception error) -> String
    def monotonic_ns: () -> Integer
    def grace_ns: (Integer nanos) -> Integer
    def join_seconds: (Integer? nanos) -> Float?
  end
end
